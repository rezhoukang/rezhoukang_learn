# ============================================
# Git 忽略规则（防止敏感文件再次入库）
# ============================================

# 1. 依赖（体积大，可重新下载）
node_modules/
vendor/
dist/

# 2. 编译产物（每次构建自动生成）
*.class
*.jar
*.log
target/
build/
out/

# 3. 敏感文件（密钥、密码、环境变量，不应提交）
.env
.env.local
.env.prod
.env.*.local
*.pem
application-prod.yml

# 4. 系统 / 编辑器临时文件
.DS_Store
Thumbs.db
.idea/
.vscode/
