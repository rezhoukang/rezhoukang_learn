# ============================================
# Library 后端环境变量配置（生产环境）
# ============================================

# 后端监听端口
SERVER_PORT=8080

# ===== MySQL 数据库 =====
# MySQL root 密码（首次启动后建议修改）
MYSQL_ROOT_PASSWORD=敏感信息
# 容器内服务名，不要改成 localhost
DB_HOST=mysql
# 容器内部端口（3306），非宿主机映射端口
DB_PORT=3306
DB_USER=root
DB_NAME=library

# ===== Redis 缓存 =====
# 容器内服务名
REDIS_HOST=redis
# 容器内部端口
REDIS_PORT=6379
# 无密码留空即可
REDIS_PASSWORD=

# ===== JWT 密钥 =====
# 生产环境务必替换为强随机字符串！
# 建议用以下命令生成：openssl rand -base64 32
JWT_SECRET=敏感信息

# 容器时区
TZ=Asia/Shanghai
